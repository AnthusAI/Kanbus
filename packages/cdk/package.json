{
  "name": "@kanbus/cdk",
  "version": "0.1.0",
  "private": false,
  "description": "AWS CDK construct that deploys the Kanbus API service with its bundled Lambda package",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "assets/kanbus-api-lambda.zip"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run typecheck && node --test dist/tests/*.test.js"
  },
  "peerDependencies": {
    "aws-cdk-lib": ">=2.215.0 <3",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "aws-cdk-lib": "2.215.0",
    "constructs": "10.4.2",
    "typescript": "^5.7.2"
  }
}
