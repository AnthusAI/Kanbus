# Jira API credentials for `kbs jira pull` / `kanbus jira pull`
# Copy this file to .env and fill in your values. Never commit .env.
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# Snyk credentials for `kbs snyk pull` / `kanbus snyk pull`
# Use the OAuth token from ~/.config/configstore/snyk.json after `snyk auth`,
# or a long-lived API token from https://app.snyk.io/account.
SNYK_TOKEN=

# LLM API key for compaction, right-now summaries, and standup rollups.
# Prefer storing it once for your user with `kbs setup ai` (writes ~/.kanbus.env, mode 600).
# Lookup order: shell environment, then ~/.kanbus.env, then this project .env file — a value
# here is used only when neither the shell nor ~/.kanbus.env provides one.
# OPENAI_API_KEY=
